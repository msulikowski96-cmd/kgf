# PostgreSQL connection string. Leave empty in development to use in-memory storage.
DATABASE_URL=postgres://user:password@localhost:5432/kgf_taxi
PORT=5000
# Long random string used to sign login tokens (required in production)
JWT_SECRET=change_me_to_a_long_random_string
# Password for the dispatcher panel at /admin
ADMIN_API_KEY=change_me_dispatcher_key
# Public address of the API. "localhost" is swapped automatically for your computer's IP in development.
EXPO_PUBLIC_API_URL=http://localhost:5000
# Simulated drivers around Poznań for testing (default: on outside production)
DEMO_DRIVERS=true
# New driver accounts approved without the dispatcher (default: on outside production)
DRIVER_AUTO_APPROVE=true
# Optional: own address search / routing / map tiles instead of the public OpenStreetMap servers
# GEOCODER_URL=https://nominatim.openstreetmap.org
# ROUTER_URL=https://router.project-osrm.org
# EXPO_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
