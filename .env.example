# PostgreSQL connection string. Leave empty in development to use in-memory storage.
DATABASE_URL=postgres://user:password@localhost:5432/kgf_taxi
PORT=5000
# Long random string used to sign login tokens (required in production)
JWT_SECRET=change_me_to_a_long_random_string
# Password for the dispatcher panel at /admin
ADMIN_API_KEY=change_me_dispatcher_key
# Public address of the API. "localhost" is swapped automatically for your computer's IP in development.
EXPO_PUBLIC_API_URL=http://localhost:5000
